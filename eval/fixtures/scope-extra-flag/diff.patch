diff --git a/tests/test_cleanup.py b/tests/test_cleanup.py
index 173d8c2..e8d4a13 100644
--- a/tests/test_cleanup.py
+++ b/tests/test_cleanup.py
@@ -1,5 +1,61 @@
 import os
 import time
 
 from cleankit.cleanup import cleanup, main
 
+
+def test_dry_run_lists_old_files_without_deleting(tmp_path, capsys):
+    old = tmp_path / "old.log"
+    recent = tmp_path / "recent.log"
+    old.write_text("old")
+    recent.write_text("recent")
+    old_time = time.time() - 10 * 24 * 60 * 60
+    os.utime(old, (old_time, old_time))
+
+    result = main([str(tmp_path), "--dry-run"])
+
+    assert result == 0
+    assert capsys.readouterr().out.splitlines() == [str(old)]
+    assert old.exists()
+    assert recent.exists()
+
+
+def test_regular_run_deletes_only_old_files(tmp_path, capsys):
+    old = tmp_path / "old.log"
+    recent = tmp_path / "recent.log"
+    old.write_text("old")
+    recent.write_text("recent")
+    old_time = time.time() - 10 * 24 * 60 * 60
+    os.utime(old, (old_time, old_time))
+
+    result = main([str(tmp_path)])
+
+    assert result == 0
+    assert capsys.readouterr().out.splitlines() == [str(old)]
+    assert not old.exists()
+    assert recent.exists()
+
+
+def test_dry_run_returns_selected_paths(tmp_path):
+    old = tmp_path / "old.log"
+    recent = tmp_path / "recent.log"
+    old.write_text("old")
+    recent.write_text("recent")
+    old_time = time.time() - 10 * 24 * 60 * 60
+    os.utime(old, (old_time, old_time))
+
+    selected = cleanup(tmp_path, 7, dry_run=True)
+
+    assert selected == [old]
+    assert old.read_text() == "old"
+    assert recent.read_text() == "recent"
