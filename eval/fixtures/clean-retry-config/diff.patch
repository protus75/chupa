+++ b/tests/test_client.py
@@ -0,0 +1,60 @@
+from unittest.mock import Mock
+
+import pytest
+import requests
+
+from tinyhttp.client import Client
+
+
+@pytest.fixture
+def session() -> Mock:
+    session = Mock(spec=requests.Session)
+    session.get.return_value.json.return_value = {"ok": True}
+    return session
+
+
+def test_default_timeout_and_json_result(session: Mock) -> None:
+    client = Client("https://api.example.test", session=session)
+
+    assert client.get("widgets") == {"ok": True}
+    session.get.assert_called_once_with(
+        "https://api.example.test/widgets", timeout=5.0
+    )
+    session.get.return_value.raise_for_status.assert_called_once_with()
+
+
+@pytest.mark.parametrize("timeout", [0.25, 12.0])
+def test_custom_timeout_is_forwarded(session: Mock, timeout: float) -> None:
+    client = Client("https://api.example.test", session=session, timeout=timeout)
+
+    assert client.get("widgets") == {"ok": True}
+    session.get.assert_called_once_with(
+        "https://api.example.test/widgets", timeout=timeout
+    )
+
+
+def test_timeout_is_per_client() -> None:
+    first_session = Mock(spec=requests.Session)
+    second_session = Mock(spec=requests.Session)
+    first = Client("https://api.example.test", session=first_session, timeout=0.5)
+    second = Client("https://api.example.test", session=second_session)
+
+    first.get("one")
+    second.get("two")
+
+    first_session.get.assert_called_once_with(
+        "https://api.example.test/one", timeout=0.5
+    )
+    second_session.get.assert_called_once_with(
+        "https://api.example.test/two", timeout=5.0
+    )
+
+
+def test_http_error_propagates_before_json(session: Mock) -> None:
+    response = session.get.return_value
+    response.raise_for_status.side_effect = requests.HTTPError("bad response")
+
+    with pytest.raises(requests.HTTPError, match="bad response"):
+        Client("https://api.example.test", session=session).get("widgets")
+
+    response.json.assert_not_called()
