@@ -0,0 +1,68 @@
+import csv
+import sqlite3
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture
+def database(tmp_path: Path) -> Path:
+    path = tmp_path / "orders.sqlite3"
+    with sqlite3.connect(path) as connection:
+        connection.execute(
+            "CREATE TABLE orders (id INTEGER PRIMARY KEY, placed_at TEXT, "
+            "status TEXT, total_cents INTEGER)"
+        )
+        connection.executemany(
+            "INSERT INTO orders (id, placed_at, status, total_cents) VALUES (?, ?, ?, ?)",
+            [
+                (8, "2026-10-01T10:00:00Z", "paid", 4200),
+                (2, "2026-10-01T09:00:00Z", "new,\ncustomer", 1200),
+                (5, "2026-10-01T09:30:00Z", "pending", 300),
+                (11, "2026-10-01T11:00:00Z", "paid", 900),
+            ],
+        )
+    return path
+
+
+def run_export(database: Path, output: Path, *options: str) -> None:
+    subprocess.run(
+        [sys.executable, "-m", "orders_export", str(database), str(output), *options],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+
+
+def read_rows(path: Path) -> list[list[str]]:
+    with path.open(encoding="utf-8", newline="") as stream:
+        return list(csv.reader(stream))
+
+
+def test_exports_ordered_rows_and_csv_fields(database: Path, tmp_path: Path) -> None:
+    output = tmp_path / "orders.csv"
+    output.write_text("previous export", encoding="utf-8")
+
+    run_export(database, output)
+
+    assert read_rows(output) == [
+        ["id", "placed_at", "status", "total_cents"],
+        ["2", "2026-10-01T09:00:00Z", "new,\ncustomer", "1200"],
+        ["5", "2026-10-01T09:30:00Z", "pending", "300"],
+        ["8", "2026-10-01T10:00:00Z", "paid", "4200"],
+        ["11", "2026-10-01T11:00:00Z", "paid", "900"],
+    ]
+
+
+def test_exports_selected_status(database: Path, tmp_path: Path) -> None:
+    output = tmp_path / "paid.csv"
+
+    run_export(database, output, "--status", "paid")
+
+    assert read_rows(output) == [
+        ["id", "placed_at", "status", "total_cents"],
+        ["8", "2026-10-01T10:00:00Z", "paid", "4200"],
+        ["11", "2026-10-01T11:00:00Z", "paid", "900"],
+    ]
