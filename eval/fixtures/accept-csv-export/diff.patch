+import argparse
+import csv
+import sqlite3
+from pathlib import Path
+
+
+def export_orders(database: Path, output: Path, status: str | None = None) -> None:
+    query = "SELECT id, placed_at, status, total_cents FROM orders"
+    params: tuple[str, ...] = ()
+    if status is not None:
+        query += " WHERE status LIKE ?"
+        params = (status,)
+    query += " ORDER BY id"
+
+    with sqlite3.connect(database) as connection:
+        rows = connection.execute(query, params).fetchall()
+
+    with output.open("w", encoding="utf-8", newline="") as stream:
+        writer = csv.writer(stream)
+        writer.writerow(("id", "placed_at", "status", "total_cents"))
+        writer.writerows(rows)
+
+
+def main(argv: list[str] | None = None) -> None:
+    parser = argparse.ArgumentParser(description="Export orders to CSV")
+    parser.add_argument("database", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--status")
+    args = parser.parse_args(argv)
+    export_orders(args.database, args.output, args.status)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_orders_export.py b/tests/test_orders_export.py
