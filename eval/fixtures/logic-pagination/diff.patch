@@ -0,0 +1,67 @@
+import pytest
+
+from listing.pagination import paginate
+
+
+def test_returns_requested_page_and_metadata():
+    result = paginate(["a", "b", "c", "d", "e"], page=2, per_page=2)
+
+    assert result == {
+        "items": ["c", "d"],
+        "page": 2,
+        "per_page": 2,
+        "total": 5,
+        "total_pages": 3,
+    }
+
+
+def test_returns_partial_last_page():
+    result = paginate(["a", "b", "c", "d", "e"], page=3, per_page=2)
+
+    assert result == {
+        "items": ["e"],
+        "page": 3,
+        "per_page": 2,
+        "total": 5,
+        "total_pages": 3,
+    }
+
+
+def test_returns_empty_page_beyond_end():
+    result = paginate(["a", "b", "c", "d", "e"], page=4, per_page=2)
+
+    assert result == {
+        "items": [],
+        "page": 4,
+        "per_page": 2,
+        "total": 5,
+        "total_pages": 3,
+    }
+
+
+def test_empty_sequence_has_zero_pages():
+    result = paginate([], page=1, per_page=2)
+
+    assert result == {
+        "items": [],
+        "page": 1,
+        "per_page": 2,
+        "total": 0,
+        "total_pages": 0,
+    }
+
+
+@pytest.mark.parametrize(
+    ("page", "per_page"),
+    [
+        (0, 2),
+        (-1, 2),
+        (1, 0),
+        (1, -2),
+        (True, 2),
+        (1, True),
+        (1.5, 2),
+        (1, 2.5),
+    ],
+)
+def test_rejects_invalid_arguments(page, per_page):
+    with pytest.raises(ValueError):
+        paginate(["a", "b"], page=page, per_page=per_page)
