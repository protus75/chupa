+"""Pagination for listing endpoints."""
+
+from collections.abc import Sequence
+from typing import TypeVar
+
+T = TypeVar("T")
+
+
+def paginate(items: Sequence[T], page: int, per_page: int) -> dict[str, object]:
+    """Return one-based page data and metadata for an in-memory sequence."""
+    if type(page) is not int or page < 1:
+        raise ValueError("page must be a positive integer")
+    if type(per_page) is not int or per_page < 1:
+        raise ValueError("per_page must be a positive integer")
+
+    total = len(items)
+    total_pages = (total + per_page) // per_page if total else 0
+    start = (page - 1) * per_page
+    page_items = list(items[start : start + per_page])
+
+    return {
+        "items": page_items,
+        "page": page,
+        "per_page": per_page,
+        "total": total,
+        "total_pages": total_pages,
+    }
