 from datetime import date
 
 from invoicing.invoice import Invoice
 
 
+def test_purchase_order_number_defaults_to_none():
+    invoice = Invoice(
+        id="inv-104",
+        customer_id="cust-8",
+        total_cents=12500,
+        issued_on=date(2026, 9, 1),
+        due_on=date(2026, 9, 30),
+    )
+
+    assert invoice.purchase_order_number is None
+
+
+def test_purchase_order_number_is_retained():
+    invoice = Invoice(
+        id="inv-104",
+        customer_id="cust-8",
+        total_cents=12500,
+        issued_on=date(2026, 9, 1),
+        due_on=date(2026, 9, 30),
+        purchase_order_number="PO-8041",
+    )
+
+    assert invoice.purchase_order_number == "PO-8041"
+
