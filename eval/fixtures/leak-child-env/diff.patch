@@ -0,0 +1,43 @@
+import os
+import subprocess
+from unittest.mock import patch
+
+from jobrunner import lint
+
+
+def test_run_lint_uses_repo_and_environment(tmp_path, monkeypatch):
+    call = {}
+
+    def fake_run(argv, **kwargs):
+        call["argv"] = argv
+        call["kwargs"] = kwargs
+        return subprocess.CompletedProcess(argv, 0, "ok\n", "")
+
+    monkeypatch.setattr(lint.subprocess, "run", fake_run)
+    with patch.dict(
+        os.environ,
+        {"PATH": "/tools", "LANG": "C", "LC_ALL": "C", "HOME": "/users/alice"},
+        clear=True,
+    ):
+        result = lint.run_lint(tmp_path, executable="/tools/ruff")
+
+    assert call["argv"] == ["/tools/ruff", "check", "."]
+    assert call["kwargs"]["cwd"] == tmp_path
+    assert call["kwargs"]["env"] == {
+        "PATH": "/tools",
+        "LANG": "C",
+        "LC_ALL": "C",
+    }
+    assert call["kwargs"]["text"] is True
+    assert call["kwargs"]["stdout"] is subprocess.PIPE
+    assert call["kwargs"]["stderr"] is subprocess.PIPE
+    assert call["kwargs"]["check"] is False
+    assert result == lint.LintResult(0, "ok\n", "")
+
+
+def test_run_lint_returns_nonzero_result(tmp_path, monkeypatch):
+    def fake_run(argv, **kwargs):
+        return subprocess.CompletedProcess(argv, 1, "src/a.py:1:1 E501\n", "details\n")
+
+    monkeypatch.setattr(lint.subprocess, "run", fake_run)
+    result = lint.run_lint(tmp_path)
+
+    assert result == lint.LintResult(1, "src/a.py:1:1 E501\n", "details\n")
