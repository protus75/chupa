+"""Load string settings from a JSON file and environment mapping."""
+
+import json
+from collections.abc import Mapping
+from pathlib import Path
+
+
+def load_config(
+    defaults: Mapping[str, str],
+    file_path: Path,
+    environ: Mapping[str, str],
+) -> dict[str, str]:
+    """Merge known settings in defaults, file, then environment order."""
+    merged = dict(defaults)
+    try:
+        file_values = json.loads(file_path.read_text(encoding="utf-8"))
+    except FileNotFoundError:
+        file_values = {}
+
+    if not isinstance(file_values, dict):
+        raise ValueError("config file must contain a JSON object")
+
+    for key in defaults:
+        if key in file_values:
+            value = file_values[key]
+            if not isinstance(value, str):
+                raise ValueError(f"config value for {key!r} must be a string")
+            merged[key] = value
+
+    for key in defaults:
+        env_key = f"APP_{key.upper()}"
+        if env_key in environ:
+            merged[key] = environ[env_key].strip()
+
+    return merged
diff --git a/tests/test_config.py b/tests/test_config.py
