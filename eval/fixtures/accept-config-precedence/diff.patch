@@ -0,0 +1,54 @@
+import json
+
+import pytest
+
+from config import load_config
+
+
+def test_file_values_replace_defaults_for_known_keys(tmp_path):
+    defaults = {"host": "localhost", "port": "8000"}
+    config_file = tmp_path / "settings.json"
+    config_file.write_text(
+        json.dumps({"host": "example.test", "extra": "ignored"}),
+        encoding="utf-8",
+    )
+
+    result = load_config(defaults, config_file, {})
+
+    assert result == {"host": "example.test", "port": "8000"}
+    assert defaults == {"host": "localhost", "port": "8000"}
+
+
+def test_environment_replaces_file_values(tmp_path):
+    config_file = tmp_path / "settings.json"
+    config_file.write_text('{"host": "from-file"}', encoding="utf-8")
+
+    result = load_config(
+        {"host": "localhost", "port": "8000"},
+        config_file,
+        {"APP_HOST": "from-env", "APP_PORT": "9000", "APP_EXTRA": "unused"},
+    )
+
+    assert result == {"host": "from-env", "port": "9000"}
+
+
+def test_missing_file_uses_defaults_and_environment(tmp_path):
+    defaults = {"host": "localhost", "port": "8000"}
+
+    result = load_config(
+        defaults,
+        tmp_path / "absent.json",
+        {"APP_PORT": "7000"},
+    )
+
+    assert result == {"host": "localhost", "port": "7000"}
+    assert defaults == {"host": "localhost", "port": "8000"}
+
+
+@pytest.mark.parametrize("contents", ["[]", '{"host": 7}'])
+def test_invalid_file_shape_or_value_raises(tmp_path, contents):
+    config_file = tmp_path / "settings.json"
+    config_file.write_text(contents, encoding="utf-8")
+
+    with pytest.raises(ValueError):
+        load_config({"host": "localhost"}, config_file, {})
