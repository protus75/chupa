@@ -0,0 +1,31 @@
+import pytest
+
+from signup.passwords import password_errors
+
+
+@pytest.mark.parametrize(
+    ("password", "expected"),
+    [
+        ("", ["length", "uppercase", "lowercase", "digit", "symbol"]),
+        ("Abcdefghi1!", ["length"]),
+        ("Abcdefghij1!", []),
+        ("abcdefghij1!", ["uppercase"]),
+        ("ABCDEFGHIJ1!", ["lowercase"]),
+        ("Abcdefghijk!", ["digit"]),
+        ("Abcdefghij12", ["symbol"]),
+        ("Abcdefghij1?", ["symbol"]),
+    ],
+)
+def test_password_errors(password: str, expected: list[str]) -> None:
+    assert password_errors(password) == expected
+
+
+def test_multiple_errors_keep_display_order() -> None:
+    assert password_errors("abcdefghijk?") == ["uppercase", "digit", "symbol"]
+
+
+def test_each_allowed_symbol_satisfies_symbol_rule() -> None:
+    for symbol in "!@#$%^&*":
+        assert password_errors(f"Abcdefghij1{symbol}") == []
+
+
+def test_length_counts_characters() -> None:
+    assert password_errors("Abcdefghij1!" * 2) == []
