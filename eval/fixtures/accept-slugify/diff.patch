@@ -0,0 +1,28 @@
+import pytest
+
+from slug import slugify
+
+
+@pytest.mark.parametrize(
+    ("title", "expected"),
+    [
+        ("  Hello, Python 3!  ", "hello-python-3"),
+        ("Crème brûlée", "creme-brulee"),
+        ("A/B__C", "a-b-c"),
+        ("One---Two", "one-two"),
+        ("Post 42", "post-42"),
+    ],
+)
+def test_slugify(title: str, expected: str) -> None:
+    assert slugify(title) == expected
+
+
+@pytest.mark.parametrize(
+    "title",
+    [
+        "",
+        "   ",
+        "!!!",
+    ],
+)
+def test_slugify_rejects_titles_without_slug_characters(title: str) -> None:
+    with pytest.raises(ValueError, match="^title has no slug characters$"):
+        slugify(title)
