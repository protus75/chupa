+"""Helpers for blog post URL paths."""
+
+import re
+import unicodedata
+
+
+_SEPARATORS = re.compile(r"[^a-z0-9]+")
+
+
+def slugify(title: str) -> str:
+    """Return an ASCII URL slug for a blog post title."""
+    normalized = unicodedata.normalize("NFKD", title.strip().lower())
+    ascii_title = normalized.encode("ascii", "ignore").decode("ascii")
+    slug = _SEPARATORS.sub("-", ascii_title).strip("-")
+    if not slug:
+        raise ValueError("title has no slug characters")
+    return slug
