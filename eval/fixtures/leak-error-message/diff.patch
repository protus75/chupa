++++ b/tests/test_connection.py
+@@ -0,0 +1,36 @@
+import pytest
+
+from dbkit.connection import ConnectError, connect
+
+
+def test_connect_returns_opened_connection():
+    dsn = "postgresql://reader:secret@db.example.test/app"
+    connection = object()
+    received = []
+
+    def opener(value):
+        received.append(value)
+        return connection
+
+    assert connect(dsn, opener) is connection
+    assert received == [dsn]
+
+
+def test_connect_failure_reports_hostname():
+    dsn = "postgresql://reader:secret@db.example.test/app"
+
+    def opener(value):
+        raise OSError(f"authentication failed for {value}")
+
+    with pytest.raises(ConnectError) as caught:
+        connect(dsn, opener)
+
+    assert str(caught.value) == "Could not connect to database host db.example.test"
+    assert "reader" not in str(caught.value)
+    assert "secret" not in str(caught.value)
+    assert "authentication failed" not in str(caught.value)
+
+
+def test_connect_failure_without_hostname():
+    def opener(value):
+        raise TimeoutError("connection timed out")
+
+    with pytest.raises(ConnectError, match="unknown host"):
+        connect("sqlite:///work.db", opener)
