+"""Database connection helper."""
+
+from collections.abc import Callable
+from typing import TypeVar
+from urllib.parse import urlsplit
+
+ConnectionT = TypeVar("ConnectionT")
+
+
+class ConnectError(RuntimeError):
+    """Raised when a database connection cannot be established."""
+
+
+def connect(dsn: str, opener: Callable[[str], ConnectionT]) -> ConnectionT:
+    """Open a connection and report its destination on failure."""
+    try:
+        return opener(dsn)
+    except Exception as exc:
+        host = urlsplit(dsn).hostname or "unknown host"
+        raise ConnectError(f"Could not connect to database host {host}") from exc
+diff --git a/tests/test_connection.py b/tests/test_connection.py
