{
	"name": "vscode-chupa",
	"displayName": "chupa tickets",
	"description": "chupa's tickets as an SCM-style dependency graph: blocked, queued, running, merged.",
	"version": "0.0.13",
	"publisher": "chupa",
	"license": "MIT",
	"engines": {
		"vscode": "^1.90.0"
	},
	"main": "./extension.js",
	"activationEvents": [
		"workspaceContains:watch.py"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "chupa",
					"title": "chupa",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"chupa": [
				{
					"type": "webview",
					"id": "chupa.details",
					"name": "Details",
					"initialSize": 2
				},
				{
					"id": "chupa.steps",
					"name": "Recent Steps",
					"initialSize": 2
				},
				{
					"type": "webview",
					"id": "chupa.tickets",
					"name": "Tickets",
					"initialSize": 6
				}
			]
		},
		"configuration": {
			"title": "chupa",
			"properties": {
				"chupa.refreshSeconds": {
					"type": "number",
					"default": 15,
					"minimum": 0,
					"description": "Seconds between timed refreshes of the chupa views. Journal, queue, engine log and ticket file changes always refresh it; 0 turns the timer off."
				},
				"chupa.unavailableMenuItems": {
					"type": "string",
					"enum": [
						"disable",
						"hide"
					],
					"default": "disable",
					"enumDescriptions": [
						"Show every ticket action; grey out the ones that cannot run right now (engine running, unmet dependencies, uncommitted draft).",
						"Show only the ticket actions that can run right now."
					],
					"description": "How the Tickets right-click menu shows actions that cannot run right now."
				}
			}
		},
		"commands": [
			{
				"command": "chupa.refresh",
				"title": "Refresh",
				"icon": "$(refresh)"
			},
			{
				"command": "chupa.ticket.open",
				"title": "Open ticket.md",
				"category": "chupa"
			},
			{
				"command": "chupa.ticket.review",
				"title": "Review",
				"category": "chupa",
				"enablement": "!chupaEngine"
			},
			{
				"command": "chupa.ticket.lint",
				"title": "Lint",
				"category": "chupa"
			},
			{
				"command": "chupa.ticket.run",
				"title": "Run now",
				"category": "chupa",
				"enablement": "chupaRunnable && !chupaEngine"
			},
			{
				"command": "chupa.ticket.confirm",
				"title": "Confirm (keep)",
				"category": "chupa",
				"enablement": "!chupaEngine || chupaDraft && chupaCommitted"
			},
			{
				"command": "chupa.ticket.reject",
				"title": "Reject (kill)",
				"category": "chupa",
				"enablement": "!chupaEngine"
			},
			{
				"command": "chupa.ticket.askDiagnose",
				"title": "Ask Claude: diagnose",
				"category": "chupa"
			},
			{
				"command": "chupa.ticket.askReview",
				"title": "Ask Claude: review",
				"category": "chupa"
			},
			{
				"command": "chupa.drain",
				"title": "Drain",
				"category": "chupa"
			},
			{
				"command": "chupa.stop",
				"title": "Stop after the running ticket",
				"category": "chupa"
			},
			{
				"command": "chupa.kill",
				"title": "Kill the drain",
				"category": "chupa"
			},
			{
				"command": "chupa.status",
				"title": "Status",
				"category": "chupa"
			},
			{
				"command": "chupa.openSettings",
				"title": "chupa Settings",
				"icon": "$(gear)"
			},
			{
				"command": "chupa.lifecycle",
				"title": "Ticket lifecycle",
				"category": "chupa",
				"icon": "$(question)"
			},
			{
				"command": "chupa.ticket.priority",
				"title": "Set priority…",
				"category": "chupa"
			},
			{
				"command": "chupa.ticket.runsBefore",
				"title": "Run before…",
				"category": "chupa"
			}
		],
		"menus": {
			"webview/context": [
				{
					"command": "chupa.ticket.open",
					"when": "webviewId == 'chupa.tickets' && chupaStem",
					"group": "1_open"
				},
				{
					"command": "chupa.ticket.review",
					"when": "webviewId == 'chupa.tickets' && chupaSection =~ /^(queued|blocked)$/ && (config.chupa.unavailableMenuItems != 'hide' || !chupaEngine)",
					"group": "2_engine@1"
				},
				{
					"command": "chupa.ticket.lint",
					"when": "webviewId == 'chupa.tickets' && chupaSection =~ /^(queued|blocked)$/",
					"group": "2_engine@2"
				},
				{
					"command": "chupa.ticket.run",
					"when": "webviewId == 'chupa.tickets' && chupaSection =~ /^(queued|blocked)$/ && (config.chupa.unavailableMenuItems != 'hide' || chupaRunnable && !chupaEngine)",
					"group": "2_engine@3"
				},
				{
					"command": "chupa.ticket.confirm",
					"when": "webviewId == 'chupa.tickets' && (chupaDraft || chupaHeld) && (config.chupa.unavailableMenuItems != 'hide' || !chupaEngine || chupaDraft && chupaCommitted)",
					"group": "3_verdict@1"
				},
				{
					"command": "chupa.ticket.reject",
					"when": "webviewId == 'chupa.tickets' && (chupaDraft || chupaHeld) && (config.chupa.unavailableMenuItems != 'hide' || !chupaEngine)",
					"group": "3_verdict@2"
				},
				{
					"command": "chupa.ticket.askDiagnose",
					"when": "webviewId == 'chupa.tickets' && chupaSection != 'merged' && chupaStem",
					"group": "4_claude@1"
				},
				{
					"command": "chupa.ticket.askReview",
					"when": "webviewId == 'chupa.tickets' && chupaSection =~ /^(queued|blocked)$/",
					"group": "4_claude@2"
				},
				{
					"command": "chupa.ticket.priority",
					"when": "webviewId == 'chupa.tickets' && chupaSection =~ /^(queued|blocked)$/",
					"group": "2_engine"
				},
				{
					"command": "chupa.ticket.runsBefore",
					"when": "webviewId == 'chupa.tickets' && chupaSection =~ /^(queued|blocked)$/",
					"group": "2_engine"
				}
			],
			"commandPalette": [
				{
					"command": "chupa.ticket.open",
					"when": "false"
				},
				{
					"command": "chupa.ticket.review",
					"when": "false"
				},
				{
					"command": "chupa.ticket.lint",
					"when": "false"
				},
				{
					"command": "chupa.ticket.run",
					"when": "false"
				},
				{
					"command": "chupa.ticket.confirm",
					"when": "false"
				},
				{
					"command": "chupa.ticket.reject",
					"when": "false"
				},
				{
					"command": "chupa.ticket.askDiagnose",
					"when": "false"
				},
				{
					"command": "chupa.ticket.askReview",
					"when": "false"
				},
				{
					"command": "chupa.openSettings",
					"when": "false"
				},
				{
					"command": "chupa.ticket.priority",
					"when": "false"
				},
				{
					"command": "chupa.ticket.runsBefore",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "chupa.refresh",
					"when": "view == chupa.tickets",
					"group": "navigation"
				},
				{
					"command": "chupa.openSettings",
					"when": "view == chupa.tickets",
					"group": "navigation"
				},
				{
					"command": "chupa.lifecycle",
					"when": "view == chupa.tickets",
					"group": "navigation"
				},
				{
					"command": "chupa.drain",
					"when": "view == chupa.tickets",
					"group": "chupa@0"
				},
				{
					"command": "chupa.stop",
					"when": "view == chupa.tickets",
					"group": "chupa@1"
				},
				{
					"command": "chupa.kill",
					"when": "view == chupa.tickets",
					"group": "chupa@2"
				},
				{
					"command": "chupa.status",
					"when": "view == chupa.tickets",
					"group": "chupa@3"
				}
			]
		},
		"colors": [
			{
				"id": "chupa.merged",
				"description": "chupa tickets view: merged tickets. Defaults to the SCM graph's historyItemRemoteRefColor color.",
				"defaults": {
					"dark": "scmGraph.historyItemRemoteRefColor",
					"light": "scmGraph.historyItemRemoteRefColor",
					"highContrast": "scmGraph.historyItemRemoteRefColor",
					"highContrastLight": "scmGraph.historyItemRemoteRefColor"
				}
			},
			{
				"id": "chupa.queued",
				"description": "chupa tickets view: queued and running tickets. Defaults to the SCM graph's historyItemRefColor color.",
				"defaults": {
					"dark": "scmGraph.historyItemRefColor",
					"light": "scmGraph.historyItemRefColor",
					"highContrast": "scmGraph.historyItemRefColor",
					"highContrastLight": "scmGraph.historyItemRefColor"
				}
			},
			{
				"id": "chupa.blocked",
				"description": "chupa tickets view: blocked tickets. Defaults to the SCM graph's historyItemBaseRefColor color.",
				"defaults": {
					"dark": "scmGraph.historyItemBaseRefColor",
					"light": "scmGraph.historyItemBaseRefColor",
					"highContrast": "scmGraph.historyItemBaseRefColor",
					"highContrastLight": "scmGraph.historyItemBaseRefColor"
				}
			}
		]
	}
}
