{
	"name": "vscode-chupa",
	"displayName": "chupa tickets",
	"description": "VS Code extension for the chupa ticket system (https://pypi.org/project/chupa/): tickets as an SCM-style dependency graph: blocked, queued, running, merged.",
	"version": "0.0.40",
	"publisher": "chunkydragon",
	"icon": "media/marketplace-icon.png",
	"extensionKind": [
		"workspace"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/protus75/chupa.git"
	},
	"files": [
		"extension.js",
		"media/**",
		"README.md",
		"LICENSE"
	],
	"license": "SEE LICENSE IN LICENSE",
	"engines": {
		"vscode": "^1.90.0"
	},
	"main": "./extension.js",
	"activationEvents": [
		"workspaceContains:tickets/*/ticket.md"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "chupa",
					"title": "chupa",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"chupa": [
				{
					"type": "webview",
					"id": "chupa.details",
					"name": "Details",
					"initialSize": 2
				},
				{
					"id": "chupa.steps",
					"name": "Recent Steps",
					"initialSize": 2
				},
				{
					"type": "webview",
					"id": "chupa.tickets",
					"name": "Tickets",
					"initialSize": 6
				},
				{
					"type": "webview",
					"id": "chupa.box",
					"name": "Suggestion Box"
				},
				{
					"id": "chupa.stats",
					"name": "Stats",
					"visibility": "collapsed"
				}
			]
		},
		"configuration": {
			"title": "chupa",
			"properties": {
				"chupa.command": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"scope": "resource",
					"default": [
						".venv/bin/chupa"
					],
					"description": "Command and arguments used to run chupa in this workspace. The default is the host\u2019s .venv/bin/chupa, resolved from the workspace folder."
				},
				"chupa.statsWindow": {
					"type": "string",
					"default": "7d",
					"pattern": "^[1-9][0-9]*[hdt]$",
					"description": "Stats window: hours (h), days (d), or last N settled tickets (t), as for chupa stats --window."
				},
				"chupa.refreshSeconds": {
					"type": "number",
					"default": 15,
					"minimum": 0,
					"description": "Seconds between timed refreshes of the chupa views. Journal, queue, engine log and ticket file changes always refresh it; 0 turns the timer off."
				},
				"chupa.unavailableMenuItems": {
					"type": "string",
					"enum": [
						"disable",
						"hide"
					],
					"default": "disable",
					"enumDescriptions": [
						"Show every ticket action; grey out the ones that cannot run right now (engine running, unmet dependencies, uncommitted draft).",
						"Show only the ticket actions that can run right now."
					],
					"description": "How the Tickets right-click menu shows actions that cannot run right now."
				},
				"chupa.playAction": {
					"type": "string",
					"enum": [
						"drain",
						"serve"
					],
					"default": "drain",
					"enumDescriptions": [
						"Run eligible tickets to quiescence, then exit.",
						"Run the continuous daemon until stopped."
					],
					"description": "Action started by the Tickets view play button."
				}
			}
		},
		"commands": [
			{
				"command": "chupa.askDrainLoop",
				"title": "Ask Claude: drain loop",
				"category": "chupa"
			},
			{
				"command": "chupa.refresh",
				"title": "Refresh",
				"icon": "$(refresh)"
			},
			{
				"command": "chupa.ticket.open",
				"title": "Open ticket.md",
				"category": "chupa"
			},
			{
				"command": "chupa.ticket.review",
				"title": "Review",
				"category": "chupa",
				"enablement": "chupaReview == 'on'"
			},
			{
				"command": "chupa.ticket.lint",
				"title": "Lint",
				"category": "chupa",
				"enablement": "chupaLint == 'on'"
			},
			{
				"command": "chupa.ticket.run",
				"title": "Run now",
				"category": "chupa",
				"enablement": "chupaRun == 'on'"
			},
			{
				"command": "chupa.ticket.confirm",
				"title": "Confirm (keep)",
				"category": "chupa",
				"enablement": "chupaConfirm == 'on'"
			},
			{
				"command": "chupa.ticket.reject",
				"title": "Reject (kill)",
				"category": "chupa",
				"enablement": "chupaReject == 'on'"
			},
			{
				"command": "chupa.ticket.askDiagnose",
				"title": "Ask Claude: diagnose",
				"category": "chupa",
				"enablement": "chupaAskDiagnose == 'on'"
			},
			{
				"command": "chupa.ticket.askReview",
				"title": "Ask Claude: review",
				"category": "chupa",
				"enablement": "chupaAskReview == 'on'"
			},
			{
				"command": "chupa.openSettings",
				"title": "chupa Settings",
				"icon": "$(gear)"
			},
			{
				"command": "chupa.lifecycle",
				"title": "Ticket lifecycle",
				"category": "chupa",
				"icon": "$(question)"
			},
			{
				"command": "chupa.ticket.priority",
				"title": "Set priority\u2026",
				"category": "chupa",
				"enablement": "chupaPriority == 'on'"
			},
			{
				"command": "chupa.ticket.runsBefore",
				"title": "Run before\u2026",
				"category": "chupa",
				"enablement": "chupaRunsBefore == 'on'"
			},
			{
				"command": "chupa.box.open",
				"title": "Open message file",
				"category": "chupa"
			},
			{
				"command": "chupa.box.link",
				"title": "Open ticket/record",
				"category": "chupa"
			},
			{
				"command": "chupa.box.triage",
				"title": "Triage",
				"category": "chupa",
				"enablement": "chupaTriage == 'on'"
			},
			{
				"command": "chupa.box.dismiss",
				"title": "Dismiss",
				"category": "chupa",
				"enablement": "chupaDismiss == 'on'"
			},
			{
				"command": "chupa.box.discuss",
				"title": "Ask Claude: discuss",
				"category": "chupa"
			},
			{
				"command": "chupa.bulkTriage",
				"title": "Bulk Triage",
				"category": "chupa"
			},
			{
				"command": "chupa.engine",
				"title": "Engine\u2026",
				"icon": "$(server-process)"
			},
			{
				"command": "chupa.playDrain",
				"title": "Start drain",
				"icon": "$(play)"
			},
			{
				"command": "chupa.playServe",
				"title": "Start serve",
				"icon": "$(play)"
			},
			{
				"command": "chupa.stopRunning",
				"title": "Stop after the running ticket",
				"icon": "$(debug-stop)"
			},
			{
				"command": "chupa.openConfig",
				"title": "Open config.yaml",
				"icon": "$(file-code)"
			},
			{
				"command": "chupa.ticket.askDrafts",
				"title": "Ask Claude: assess drafts",
				"category": "chupa",
				"enablement": "chupaAskDrafts == 'on'"
			}
		],
		"menus": {
			"webview/context": [
				{
					"command": "chupa.ticket.open",
					"when": "webviewId == 'chupa.tickets' && chupaStem",
					"group": "1_open"
				},
				{
					"command": "chupa.ticket.review",
					"when": "webviewId == 'chupa.tickets' && (chupaReview == 'on' || chupaReview == 'locked' && config.chupa.unavailableMenuItems != 'hide')",
					"group": "2_engine@1"
				},
				{
					"command": "chupa.ticket.lint",
					"when": "webviewId == 'chupa.tickets' && (chupaLint == 'on' || chupaLint == 'locked' && config.chupa.unavailableMenuItems != 'hide')",
					"group": "2_engine@2"
				},
				{
					"command": "chupa.ticket.run",
					"when": "webviewId == 'chupa.tickets' && (chupaRun == 'on' || chupaRun == 'locked' && config.chupa.unavailableMenuItems != 'hide')",
					"group": "2_engine@3"
				},
				{
					"command": "chupa.ticket.confirm",
					"when": "webviewId == 'chupa.tickets' && (chupaConfirm == 'on' || chupaConfirm == 'locked' && config.chupa.unavailableMenuItems != 'hide')",
					"group": "3_verdict@1"
				},
				{
					"command": "chupa.ticket.reject",
					"when": "webviewId == 'chupa.tickets' && (chupaReject == 'on' || chupaReject == 'locked' && config.chupa.unavailableMenuItems != 'hide')",
					"group": "3_verdict@2"
				},
				{
					"command": "chupa.ticket.askDiagnose",
					"when": "webviewId == 'chupa.tickets' && (chupaAskDiagnose == 'on' || chupaAskDiagnose == 'locked' && config.chupa.unavailableMenuItems != 'hide')",
					"group": "4_claude@1"
				},
				{
					"command": "chupa.ticket.askReview",
					"when": "webviewId == 'chupa.tickets' && (chupaAskReview == 'on' || chupaAskReview == 'locked' && config.chupa.unavailableMenuItems != 'hide')",
					"group": "4_claude@2"
				},
				{
					"command": "chupa.ticket.priority",
					"when": "webviewId == 'chupa.tickets' && (chupaPriority == 'on' || chupaPriority == 'locked' && config.chupa.unavailableMenuItems != 'hide')",
					"group": "2_engine"
				},
				{
					"command": "chupa.ticket.runsBefore",
					"when": "webviewId == 'chupa.tickets' && (chupaRunsBefore == 'on' || chupaRunsBefore == 'locked' && config.chupa.unavailableMenuItems != 'hide')",
					"group": "2_engine"
				},
				{
					"command": "chupa.box.open",
					"when": "webviewId == 'chupa.box' && chupaPath",
					"group": "box@10"
				},
				{
					"command": "chupa.box.link",
					"when": "webviewId == 'chupa.box' && chupaLink",
					"group": "box@11"
				},
				{
					"command": "chupa.box.triage",
					"when": "webviewId == 'chupa.box' && (chupaTriage == 'on' || chupaTriage == 'locked' && config.chupa.unavailableMenuItems != 'hide')",
					"group": "box@12"
				},
				{
					"command": "chupa.box.dismiss",
					"when": "webviewId == 'chupa.box' && (chupaDismiss == 'on' || chupaDismiss == 'locked' && config.chupa.unavailableMenuItems != 'hide')",
					"group": "box@13"
				},
				{
					"command": "chupa.box.discuss",
					"when": "webviewId == 'chupa.box' && chupaIds",
					"group": "box@14"
				},
				{
					"command": "chupa.ticket.askDrafts",
					"when": "webviewId == 'chupa.tickets' && (chupaAskDrafts == 'on' || chupaAskDrafts == 'locked' && config.chupa.unavailableMenuItems != 'hide')",
					"group": "4_claude@3"
				}
			],
			"commandPalette": [
				{
					"command": "chupa.askDrainLoop",
					"when": "false"
				},
				{
					"command": "chupa.ticket.open",
					"when": "false"
				},
				{
					"command": "chupa.ticket.review",
					"when": "false"
				},
				{
					"command": "chupa.ticket.lint",
					"when": "false"
				},
				{
					"command": "chupa.ticket.run",
					"when": "false"
				},
				{
					"command": "chupa.ticket.confirm",
					"when": "false"
				},
				{
					"command": "chupa.ticket.reject",
					"when": "false"
				},
				{
					"command": "chupa.ticket.askDiagnose",
					"when": "false"
				},
				{
					"command": "chupa.ticket.askReview",
					"when": "false"
				},
				{
					"command": "chupa.openSettings",
					"when": "false"
				},
				{
					"command": "chupa.ticket.priority",
					"when": "false"
				},
				{
					"command": "chupa.ticket.runsBefore",
					"when": "false"
				},
				{
					"command": "chupa.box.open",
					"when": "false"
				},
				{
					"command": "chupa.box.link",
					"when": "false"
				},
				{
					"command": "chupa.box.triage",
					"when": "false"
				},
				{
					"command": "chupa.box.dismiss",
					"when": "false"
				},
				{
					"command": "chupa.box.discuss",
					"when": "false"
				},
				{
					"command": "chupa.bulkTriage",
					"when": "false"
				},
				{
					"command": "chupa.engine",
					"when": "false"
				},
				{
					"command": "chupa.playDrain",
					"when": "false"
				},
				{
					"command": "chupa.playServe",
					"when": "false"
				},
				{
					"command": "chupa.stopRunning",
					"when": "false"
				},
				{
					"command": "chupa.openConfig",
					"when": "false"
				},
				{
					"command": "chupa.ticket.askDrafts",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "chupa.askDrainLoop",
					"when": "view == chupa.tickets",
					"group": "chupa@7"
				},
				{
					"command": "chupa.refresh",
					"when": "view == chupa.stats",
					"group": "navigation"
				},
				{
					"command": "chupa.refresh",
					"when": "view == chupa.tickets",
					"group": "navigation"
				},
				{
					"command": "chupa.openSettings",
					"when": "view == chupa.tickets",
					"group": "navigation"
				},
				{
					"command": "chupa.lifecycle",
					"when": "view == chupa.tickets",
					"group": "chupa@6"
				},
				{
					"command": "chupa.bulkTriage",
					"when": "view == chupa.tickets",
					"group": "chupa@4"
				},
				{
					"command": "chupa.engine",
					"when": "view == chupa.tickets",
					"group": "navigation"
				},
				{
					"command": "chupa.playDrain",
					"when": "view == chupa.tickets && !chupa.engineRunning && config.chupa.playAction == 'drain'",
					"group": "navigation"
				},
				{
					"command": "chupa.playServe",
					"when": "view == chupa.tickets && !chupa.engineRunning && config.chupa.playAction == 'serve'",
					"group": "navigation"
				},
				{
					"command": "chupa.stopRunning",
					"when": "view == chupa.tickets && chupa.engineRunning",
					"group": "navigation"
				},
				{
					"command": "chupa.openConfig",
					"when": "view == chupa.tickets",
					"group": "chupa@5"
				}
			]
		},
		"colors": [
			{
				"id": "chupa.merged",
				"description": "chupa tickets view: merged tickets. Defaults to the SCM graph's historyItemRemoteRefColor color.",
				"defaults": {
					"dark": "scmGraph.historyItemRemoteRefColor",
					"light": "scmGraph.historyItemRemoteRefColor",
					"highContrast": "scmGraph.historyItemRemoteRefColor",
					"highContrastLight": "scmGraph.historyItemRemoteRefColor"
				}
			},
			{
				"id": "chupa.queued",
				"description": "chupa tickets view: queued and running tickets. Defaults to the SCM graph's historyItemRefColor color.",
				"defaults": {
					"dark": "scmGraph.historyItemRefColor",
					"light": "scmGraph.historyItemRefColor",
					"highContrast": "scmGraph.historyItemRefColor",
					"highContrastLight": "scmGraph.historyItemRefColor"
				}
			},
			{
				"id": "chupa.blocked",
				"description": "chupa tickets view: blocked tickets. Defaults to the SCM graph's historyItemBaseRefColor color.",
				"defaults": {
					"dark": "scmGraph.historyItemBaseRefColor",
					"light": "scmGraph.historyItemBaseRefColor",
					"highContrast": "scmGraph.historyItemBaseRefColor",
					"highContrastLight": "scmGraph.historyItemBaseRefColor"
				}
			}
		]
	}
}
